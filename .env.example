# HTTP server port
PORT=3000
# Environment: development|staging|production
ENVIRONMENT=development
# OpenAI-compatible API (local LM Studio server or a cloud provider)
LLM_BASE_URL=http://localhost:1234/v1
# OAny string for local LM Studio server, or your cloud provider API key
LLM_API_KEY=local
# Model name for the LLM to use. For example, "qwen/qwen3.5-9b" for Qwen-3.5-9B model.
LLM_MODEL=model-name
