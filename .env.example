# HTTP server port
PORT=3000
# Environment: development|staging|production (development writes Lighthouse reports to reports/)
ENVIRONMENT=development
# Copilot model for the agent ("auto" lets Copilot choose)
COPILOT_MODEL=auto
# How many times to retry the agent when it returns invalid LLM output (default 3)
AGENT_RETRIES=3
# GitHub token for Copilot auth; omit to use `copilot login`
GITHUB_TOKEN=
# Custom OpenAI-compatible LLM provider. Set all three CUSTOM_PROVIDER_* variables
# to run the agent against your own provider instead of built-in Copilot models.
CUSTOM_PROVIDER_BASE_URL=http://localhost:1234
CUSTOM_PROVIDER_API_KEY=local
CUSTOM_PROVIDER_MODEL=qwen/qwen3.5-9b
