{
  "name": "vailidator",
  "version": "1.0.0",
  "description": "HTTP server that runs a Lighthouse audit on HTML markup, sends results to an LLM, and returns a structured HTML validation report.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run lint && npm run build && nodemon --watch src --ext ts --exec \"node --loader ts-node/esm src/server.ts\"",
    "build": "tsc",
    "lint": "eslint .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lighthouse": "^12.2.1",
    "openai": "^4.67.3",
    "puppeteer": "^23.6.0",
    "serve-static": "^1.16.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/serve-static": "^1.15.7",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0"
  }
}
